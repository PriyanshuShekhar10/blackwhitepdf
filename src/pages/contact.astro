---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact BlackWhitePDF — Support, Feedback & Bug Reports";
const description =
  "Get in touch with the BlackWhitePDF team. Email us with questions, feedback, bug reports, or feature ideas about the free grayscale and black and white PDF converter.";
const path = "/contact/";
const email = "hello@blackwhitepdf.com";
const site = Astro.site ?? new URL("https://blackwhitepdf.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: new URL(path, site).href,
  isPartOf: {
    "@type": "WebSite",
    name: "BlackWhitePDF",
    url: new URL("/", site).href,
  },
  mainEntity: {
    "@type": "Organization",
    name: "BlackWhitePDF",
    url: new URL("/", site).href,
    email,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email,
      availableLanguage: ["English"],
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  current="contact"
  keywords="contact blackwhitepdf, blackwhitepdf support, grayscale pdf converter contact, black and white pdf converter support"
  jsonLd={jsonLd}
>
  <main id="main" class="scroll-mt-4 border-b border-hairline bg-canvas">
    <article class="mx-auto max-w-[720px] px-6 py-16 md:py-20">
      <p class="mb-3 font-mono text-xs uppercase tracking-wide text-mute">Contact</p>
      <h1
        class="text-[34px] font-semibold leading-tight tracking-[-1.4px] text-balance md:text-[40px] md:tracking-[-1.8px]"
      >
        Contact BlackWhitePDF.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-body text-pretty">
        Have a question, found a bug, or want a new feature in the grayscale and
        black and white PDF converter? We read every message and would love to
        hear how you use the tool.
      </p>

      <div class="mt-10 rounded-lg border border-hairline bg-canvas-soft p-6 shadow-card">
        <p class="font-mono text-xs uppercase tracking-wide text-mute">Email us</p>
        <a
          href={`mailto:${email}`}
          class="mt-2 inline-block text-xl font-semibold tracking-[-0.4px] text-link underline hover:text-link-deep"
          translate="no">{email}</a
        >
        <p class="mt-3 text-sm leading-relaxed text-body">
          We usually reply within a few business days. Everything runs in your
          browser, so we never see your files — please don’t attach sensitive
          documents to your email.
        </p>
        <a
          href={`mailto:${email}?subject=BlackWhitePDF%20feedback`}
          class="mt-5 inline-flex h-11 items-center justify-center rounded-md bg-ink px-5 text-sm font-medium text-white transition-colors hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 dark:text-canvas-soft"
          >Send us an email</a
        >
      </div>

      <div class="prose-legal mt-12 space-y-5 text-base leading-relaxed text-body">
        <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink">What to include</h2>
        <p>
          For bug reports, it helps to mention your browser and operating system,
          the resolution (DPI) and mode you used, and what you expected to happen.
          For feature requests, a quick description of the document you were
          working with lets us reproduce your workflow.
        </p>

        <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink">Privacy first</h2>
        <p>
          BlackWhitePDF processes every PDF locally in your browser and never
          uploads your files. Read more in our
          <a href="/privacy/" class="text-link underline hover:text-link-deep">Privacy Policy</a>
          and <a href="/terms/" class="text-link underline hover:text-link-deep">Terms &amp; Conditions</a>,
          or learn who we are on the
          <a href="/about/" class="text-link underline hover:text-link-deep">About Us</a> page.
        </p>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .prose-legal h2 {
    margin-top: 2rem;
  }
  .prose-legal h2:first-child {
    margin-top: 0;
  }
</style>
