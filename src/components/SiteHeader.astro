---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getContent } from "../i18n";

interface Props {
  current?: "home" | "about" | "privacy" | "terms" | "contact";
  lang?: string;
  route?: string | null;
}

const { current = "home", lang = "en", route = null } = Astro.props;
const nav = getContent(lang).nav;

// Home + About are localized per-locale; legal pages stay at their English URLs.
const links = [
  { href: getRelativeLocaleUrl(lang, ""), id: "home", label: nav.converter },
  { href: getRelativeLocaleUrl(lang, "about"), id: "about", label: nav.about },
  { href: "/privacy/", id: "privacy", label: nav.privacy },
  { href: "/terms/", id: "terms", label: nav.terms },
  { href: "/contact/", id: "contact", label: nav.contact },
] as const;

const homeHref = getRelativeLocaleUrl(lang, "");
---

<header class="border-b border-hairline bg-canvas">
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-2 px-4 py-3 sm:h-16 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-0"
  >
    <a
      href={homeHref}
      data-astro-reload
      class="order-1 flex min-w-0 max-w-full items-center gap-2.5 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
    >
      <span
        aria-hidden="true"
        class="grid size-6 shrink-0 place-items-center rounded-[6px] bg-ink text-white dark:text-canvas-soft"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 3h8l4 4v14H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <path d="M8 12h8M8 16h5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="truncate font-mono text-[13px] tracking-tight text-ink" translate="no"
        >blackwhitepdf.com</span
      >
    </a>

    <nav
      aria-label="Primary"
      class="order-3 flex w-full flex-wrap items-center justify-center gap-0.5 sm:order-2 sm:w-auto sm:gap-1"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            data-astro-reload
            aria-current={current === link.id ? "page" : undefined}
            class:list={[
              "rounded-full px-2.5 py-1.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 sm:px-3",
              current === link.id
                ? "bg-canvas-soft font-medium text-ink"
                : "text-body hover:bg-canvas-soft hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="order-2 flex shrink-0 items-center gap-2 sm:order-3">
      <LanguageSwitcher lang={lang} route={route} />
      <button
        id="themeToggle"
        type="button"
        aria-label="Toggle dark mode"
        class="grid size-9 shrink-0 place-items-center rounded-full border border-hairline text-body transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
      >
        <svg
          class="dark:hidden"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
          />
        </svg>
        <svg
          class="hidden dark:block"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("themeToggle");

  function syncMeta(isDark: boolean) {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", isDark ? "#0a0a0a" : "#ffffff");
    toggle?.setAttribute("aria-pressed", String(isDark));
  }

  function setTheme(isDark: boolean) {
    root.classList.toggle("dark", isDark);
    root.style.colorScheme = isDark ? "dark" : "light";
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch (e) {}
    syncMeta(isDark);
  }

  // Sync the button/meta with whatever the pre-paint inline script decided.
  syncMeta(root.classList.contains("dark"));

  toggle?.addEventListener("click", () =>
    setTheme(!root.classList.contains("dark"))
  );

  // Follow the OS only while the user hasn't made an explicit choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      try {
        if (!localStorage.getItem("theme")) {
          root.classList.toggle("dark", e.matches);
          root.style.colorScheme = e.matches ? "dark" : "light";
          syncMeta(e.matches);
        }
      } catch (err) {}
    });
</script>
