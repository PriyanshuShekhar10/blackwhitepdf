---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import exampleImg from "../image.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent } from "../i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const c = getContent(lang);
const site = Astro.site ?? new URL("https://blackwhitepdf.com");
const path = getRelativeLocaleUrl(lang, "");
const pageUrl = new URL(path, site).href;
const privacyHref = "/privacy/";

const faqs = c.faq.items;

const jsonLdApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "BlackWhitePDF — Grayscale & Black and White PDF Converter",
  url: pageUrl,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires a modern browser with JavaScript enabled",
  inLanguage: lang,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description: c.home.description,
  featureList: [
    "Convert color PDF to grayscale PDF",
    "Convert color PDF to black and white PDF",
    "Perspective crop and deskew",
    "Private in-browser processing",
  ],
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={c.home.title}
  description={c.home.description}
  path={path}
  current="home"
  keywords={c.home.keywords}
  jsonLd={[jsonLdApp, jsonLdFaq]}
  lang={lang}
  route=""
>
  <main id="main" class="scroll-mt-4">
    <section id="hero" class="relative overflow-hidden border-b border-hairline bg-canvas">
      <div class="mesh" aria-hidden="true"></div>
      <div
        class="relative mx-auto grid max-w-[1200px] items-start gap-10 px-6 py-16 md:grid-cols-2 md:py-20"
      >
        <div>
          <p class="mb-4 font-mono text-xs uppercase tracking-wide text-mute">
            {c.hero.eyebrow}
          </p>
          <h1
            class="text-[34px] font-semibold leading-[1.05] tracking-[-1.6px] text-balance md:text-[48px] md:tracking-[-2.4px]"
          >
            {c.hero.h1}
          </h1>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-body text-pretty">
            {c.hero.subLead}<a href={privacyHref} class="text-link underline hover:text-link-deep">{c.hero.privacyLinkText}</a>.
          </p>

          <input id="file" type="file" accept="application/pdf" aria-label="Upload PDF" class="sr-only" />
          <button
            id="dropzone"
            type="button"
            class="group mt-8 w-full rounded-xl border-2 border-dashed border-hairline bg-canvas-soft px-6 py-10 text-center transition-colors hover:border-ink/25 hover:bg-canvas-soft-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 [&.dragging]:border-ink [&.dragging]:bg-canvas-soft-2"
          >
            <span
              aria-hidden="true"
              class="mx-auto mb-4 grid size-12 place-items-center rounded-full bg-ink text-white dark:text-canvas-soft"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 16V4M12 4l-5 5M12 4l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
            <p class="text-base text-ink">
              <span class="font-medium">{c.hero.dropTitleBold}</span>{c.hero.dropTitleRest}
            </p>
            <p class="mt-1 text-sm text-mute">
              {c.hero.dropSub}
            </p>
          </button>
        </div>

        <figure class="overflow-hidden rounded-lg border border-hairline bg-canvas shadow-float">
          <Image
            src={exampleImg}
            alt={c.hero.imageAlt}
            loading="eager"
            fetchpriority="high"
            class="block h-auto w-full"
          />
          <figcaption class="border-t border-hairline px-4 py-2 font-mono text-xs text-mute">
            {c.hero.caption}
          </figcaption>
        </figure>
      </div>
    </section>

    <div class="mx-auto max-w-[1200px] px-6 py-10">
      <section
        id="workspace"
        hidden
        class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[340px_1fr]"
        data-processing={c.ui.processing}
        data-starting={c.ui.starting}
        data-processing-page={c.ui.processingPage}
        data-done={c.ui.done}
        data-error={c.ui.error}
        data-invalid={c.ui.invalidFile}
        data-page-singular={c.ui.pagesSingular}
        data-page-plural={c.ui.pagesPlural}
      >
        <div
          class="flex flex-col gap-5 rounded-lg border border-hairline bg-canvas p-6 shadow-card lg:sticky lg:top-6"
        >
          <div class="flex items-center justify-between gap-2">
            <span id="fileName" class="min-w-0 truncate font-medium">{c.ui.fileNameDefault}</span>
            <span
              id="pageCount"
              class="shrink-0 rounded-full border border-hairline bg-canvas-soft px-2 py-1 text-xs text-body tabular-nums"
              >0 {c.ui.pagesPlural}</span
            >
          </div>

          <div class="h-px bg-hairline"></div>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-body">{c.ui.mode}</span>
            <div
              id="mode"
              role="group"
              aria-label={c.ui.mode}
              class="grid grid-cols-2 gap-1 rounded-md border border-hairline bg-canvas-soft p-1"
            >
              <button type="button" data-value="bw" class="seg-btn">{c.ui.modeBw}</button>
              <button type="button" data-value="gray" class="seg-btn active">{c.ui.modeGray}</button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="dpi" class="text-sm font-medium text-body">{c.ui.resolution}</label>
            <select
              id="dpi"
              class="h-10 w-full rounded-md border border-hairline bg-canvas px-3 text-sm text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
            >
              <option value="120">{c.ui.dpi120}</option>
              <option value="150">{c.ui.dpi150}</option>
              <option value="200" selected>{c.ui.dpi200}</option>
              <option value="300">{c.ui.dpi300}</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="threshold" class="flex items-center justify-between text-sm font-medium text-body">
              <span>{c.ui.inkThreshold}</span>
              <span id="thresholdVal" class="font-mono text-xs text-ink tabular-nums">12</span>
            </label>
            <input id="threshold" type="range" min="0" max="40" value="12" class="w-full" />
            <span class="text-xs leading-relaxed text-mute">{c.ui.inkThresholdHelp}</span>
          </div>

          <div class="flex flex-col gap-2">
            <label for="blockRadius" class="flex items-center justify-between text-sm font-medium text-body">
              <span>{c.ui.detailSize}</span>
              <span id="blockRadiusVal" class="font-mono text-xs text-ink tabular-nums">12</span>
            </label>
            <input id="blockRadius" type="range" min="4" max="40" value="12" class="w-full" />
            <span class="text-xs leading-relaxed text-mute">{c.ui.detailSizeHelp}</span>
          </div>

          <div class="flex flex-col gap-2">
            <label for="contrast" class="flex items-center justify-between text-sm font-medium text-body">
              <span>{c.ui.contrast}</span>
              <span id="contrastVal" class="font-mono text-xs text-ink tabular-nums">1.15</span>
            </label>
            <input id="contrast" type="range" min="1" max="2" step="0.05" value="1.15" class="w-full" />
          </div>

          <label class="flex cursor-pointer items-center gap-2.5 text-sm text-ink">
            <input id="despeckle" type="checkbox" checked class="size-4 accent-ink" />
            {c.ui.despeckle}
          </label>

          <label class="flex cursor-pointer items-center gap-2.5 text-sm text-ink">
            <input id="cropEnabled" type="checkbox" class="size-4 accent-ink" />
            {c.ui.crop}
          </label>
          <span id="cropHint" hidden class="text-xs leading-relaxed text-mute">
            {c.ui.cropHintLead}<span class="font-medium text-body">{c.ui.cropHintOriginal}</span>{c.ui.cropHintTail}
            <button id="cropReset" type="button" class="rounded text-link underline hover:text-link-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40">{c.ui.cropReset}</button>
          </span>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-body">{c.ui.previewPage}</span>
            <div class="flex items-center justify-between gap-2">
              <button
                id="prevPage"
                type="button"
                aria-label={c.ui.prevPage}
                class="inline-flex h-9 w-10 items-center justify-center rounded-md border border-hairline bg-canvas text-lg text-ink transition-colors hover:bg-canvas-soft-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 disabled:cursor-not-allowed disabled:opacity-40"
              >‹</button>
              <span id="pageIndicator" class="text-sm text-body tabular-nums">1 / 1</span>
              <button
                id="nextPage"
                type="button"
                aria-label={c.ui.nextPage}
                class="inline-flex h-9 w-10 items-center justify-center rounded-md border border-hairline bg-canvas text-lg text-ink transition-colors hover:bg-canvas-soft-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 disabled:cursor-not-allowed disabled:opacity-40"
              >›</button>
            </div>
          </div>

          <button
            id="processBtn"
            class="mt-1 inline-flex h-11 w-full items-center justify-center rounded-md bg-ink px-4 text-sm font-medium text-white transition-colors hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 disabled:cursor-progress disabled:opacity-60 dark:text-canvas-soft"
            >{c.ui.convert}</button
          >
          <button
            id="resetBtn"
            class="inline-flex h-10 w-full items-center justify-center rounded-md border border-hairline bg-canvas px-4 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 disabled:opacity-50"
            >{c.ui.chooseAnother}</button
          >

          <div id="progress" hidden aria-live="polite" class="flex flex-col gap-2">
            <div class="h-2 overflow-hidden rounded-full bg-canvas-soft-2">
              <div id="progressFill" class="h-full w-full origin-left scale-x-0 bg-ink transition-transform duration-200"></div>
            </div>
            <span id="progressText" class="text-xs text-body">{c.ui.processing}</span>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <span class="font-mono text-xs uppercase tracking-wide text-mute">{c.ui.original}</span>
            <div
              id="beforeWrap"
              class="canvas-wrap relative grid min-h-[220px] place-items-center overflow-hidden rounded-lg border border-hairline bg-white shadow-card"
            >
              <canvas id="beforeCanvas" class="block h-auto w-full"></canvas>
              <div id="cropOverlay" class="crop-overlay" hidden>
                <svg id="cropSvg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <polygon id="cropPoly" points="" />
                </svg>
                <button type="button" class="crop-handle" data-corner="0" aria-label={`${c.ui.cropCorner} 1`}></button>
                <button type="button" class="crop-handle" data-corner="1" aria-label={`${c.ui.cropCorner} 2`}></button>
                <button type="button" class="crop-handle" data-corner="2" aria-label={`${c.ui.cropCorner} 3`}></button>
                <button type="button" class="crop-handle" data-corner="3" aria-label={`${c.ui.cropCorner} 4`}></button>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <span class="font-mono text-xs uppercase tracking-wide text-mute">{c.ui.scanned}</span>
            <div
              class="canvas-wrap relative grid min-h-[220px] place-items-center overflow-hidden rounded-lg border border-hairline bg-white shadow-card"
            >
              <canvas id="afterCanvas" class="block h-auto w-full"></canvas>
              <div id="previewSpinner" class="spinner" hidden></div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <article
      id="about"
      class="scroll-mt-16 border-t border-hairline bg-canvas-soft"
      aria-labelledby="about-heading"
    >
      <div class="mx-auto max-w-[720px] px-6 py-16 md:py-20">
        <p class="mb-3 font-mono text-xs uppercase tracking-wide text-mute">
          {c.about.eyebrow}
        </p>
        <h2
          id="about-heading"
          class="text-[28px] font-semibold leading-tight tracking-[-1px] text-balance md:text-[32px] md:tracking-[-1.28px]"
        >
          {c.about.h2}
        </h2>

        <div class="mt-8 space-y-5 text-base leading-relaxed text-body">
          <p>{c.about.p1}</p>
          <p>{c.about.p2}</p>

          <h3 class="pt-2 text-xl font-semibold tracking-[-0.6px] text-ink">
            {c.about.steps.h3}
          </h3>
          <p>{c.about.steps.p}</p>

          <h3 class="pt-2 text-xl font-semibold tracking-[-0.6px] text-ink">
            {c.about.bw.h3}
          </h3>
          <p>{c.about.bw.p}</p>

          <h3 class="pt-2 text-xl font-semibold tracking-[-0.6px] text-ink">
            {c.about.private.h3}
          </h3>
          <p>{c.about.private.p}</p>
        </div>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2">
          {
            c.about.cards.map((card) => (
              <li class="rounded-md border border-hairline bg-canvas p-4 text-sm text-body shadow-card">
                <span class="block font-medium text-ink">{card.title}</span>
                {card.desc}
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <section
      id="faq"
      class="scroll-mt-16 border-t border-hairline bg-canvas"
      aria-labelledby="faq-heading"
    >
      <div class="mx-auto max-w-[720px] px-6 py-16 md:py-20">
        <p class="mb-3 font-mono text-xs uppercase tracking-wide text-mute">{c.faq.eyebrow}</p>
        <h2
          id="faq-heading"
          class="text-[28px] font-semibold leading-tight tracking-[-1px] text-balance md:text-[32px] md:tracking-[-1.28px]"
        >
          {c.faq.h2}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-body">
          {c.faq.subhead}
        </p>

        <div class="mt-10 divide-y divide-hairline border-y border-hairline">
          {
            faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left text-base font-medium text-ink marker:content-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 [&::-webkit-details-marker]:hidden">
                  <span class="text-pretty">{faq.question}</span>
                  <span
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 text-mute transition-transform duration-150 group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 pr-8 text-sm leading-relaxed text-body">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <script>
    import type {
      LoadedPdf,
      ScanOptions,
      ScanMode,
      Quad,
    } from "../scripts/scanner.ts";

    // Lazy-load the heavy PDF stack (pdf.js + jsPDF) only when the user first
    // interacts, so it never blocks initial paint / Core Web Vitals.
    type ScannerModule = typeof import("../scripts/scanner.ts");
    let scannerPromise: Promise<ScannerModule> | null = null;
    const getScanner = () => (scannerPromise ??= import("../scripts/scanner.ts"));

    const $ = <T extends HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const hero = $("hero");
    const dropzone = $("dropzone");
    const fileInput = $<HTMLInputElement>("file");
    const workspace = $("workspace");
    const fileNameEl = $("fileName");
    const pageCountEl = $("pageCount");

    // Localized UI strings injected from the content dictionary via data-*.
    const t = {
      starting: workspace.dataset.starting ?? "Starting…",
      processingPage:
        workspace.dataset.processingPage ?? "Processing page {page} of {total}…",
      done: workspace.dataset.done ?? "Done — download started.",
      error:
        workspace.dataset.error ??
        "Something went wrong. Try a lower DPI or another PDF.",
      invalid: workspace.dataset.invalid ?? "Please choose a PDF file.",
      pageSingular: workspace.dataset.pageSingular ?? "page",
      pagePlural: workspace.dataset.pagePlural ?? "pages",
    };

    const modeEl = $("mode");
    const dpiEl = $<HTMLSelectElement>("dpi");
    const thresholdEl = $<HTMLInputElement>("threshold");
    const blockRadiusEl = $<HTMLInputElement>("blockRadius");
    const contrastEl = $<HTMLInputElement>("contrast");
    const despeckleEl = $<HTMLInputElement>("despeckle");
    const cropEnabledEl = $<HTMLInputElement>("cropEnabled");
    const cropHint = $("cropHint");
    const cropResetBtn = $<HTMLButtonElement>("cropReset");
    const cropOverlay = $("cropOverlay");
    const cropPoly = document.getElementById("cropPoly") as unknown as SVGPolygonElement;
    const beforeWrap = $("beforeWrap");
    const cropHandles = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".crop-handle")
    );

    const thresholdVal = $("thresholdVal");
    const blockRadiusVal = $("blockRadiusVal");
    const contrastVal = $("contrastVal");

    const prevPageBtn = $<HTMLButtonElement>("prevPage");
    const nextPageBtn = $<HTMLButtonElement>("nextPage");
    const pageIndicator = $("pageIndicator");

    const processBtn = $<HTMLButtonElement>("processBtn");
    const resetBtn = $<HTMLButtonElement>("resetBtn");
    const progress = $("progress");
    const progressFill = $("progressFill");
    const progressText = $("progressText");
    const previewSpinner = $("previewSpinner");

    const beforeCanvas = $<HTMLCanvasElement>("beforeCanvas");
    const afterCanvas = $<HTMLCanvasElement>("afterCanvas");

    let fileBuffer: ArrayBuffer | null = null;
    let fileName = "document.pdf";
    let pdf: LoadedPdf | null = null;
    let currentPage = 1;
    let previewToken = 0;

    const PREVIEW_DPI = 110;

    const defaultQuad = (): Quad => [
      { x: 0.06, y: 0.06 },
      { x: 0.94, y: 0.06 },
      { x: 0.94, y: 0.94 },
      { x: 0.06, y: 0.94 },
    ];
    let cropQuad: Quad = defaultQuad();

    function readOptions(): ScanOptions {
      return {
        dpi: parseInt(dpiEl.value, 10),
        mode: (modeEl.querySelector("button.active") as HTMLButtonElement)
          .dataset.value as ScanMode,
        threshold: parseInt(thresholdEl.value, 10),
        blockRadius: parseInt(blockRadiusEl.value, 10),
        contrast: parseFloat(contrastEl.value),
        despeckle: despeckleEl.checked,
        crop: cropEnabledEl.checked ? cropQuad : null,
      };
    }

    function renderCropOverlay() {
      const on = cropEnabledEl.checked;
      cropOverlay.hidden = !on;
      cropHint.hidden = !on;
      if (!on) return;
      cropPoly.setAttribute(
        "points",
        cropQuad.map((p) => `${p.x * 100},${p.y * 100}`).join(" ")
      );
      cropHandles.forEach((h, i) => {
        h.style.left = `${cropQuad[i].x * 100}%`;
        h.style.top = `${cropQuad[i].y * 100}%`;
      });
    }

    function drawToCanvas(target: HTMLCanvasElement, source: HTMLCanvasElement) {
      target.width = source.width;
      target.height = source.height;
      target.getContext("2d")!.drawImage(source, 0, 0);
    }

    async function refreshPreview() {
      if (!pdf) return;
      const token = ++previewToken;
      previewSpinner.hidden = false;
      try {
        const { applyScanFilter, warpQuad } = await getScanner();
        const opts = readOptions();
        const original = await pdf.renderPage(currentPage, PREVIEW_DPI);
        if (token !== previewToken) return;
        drawToCanvas(beforeCanvas, original);
        renderCropOverlay();

        let working = original;
        if (opts.crop) {
          const quadPx = opts.crop.map((p) => ({
            x: p.x * original.width,
            y: p.y * original.height,
          })) as Quad;
          working = warpQuad(original, quadPx);
        }
        const octx = working.getContext("2d", { willReadFrequently: true })!;
        const image = octx.getImageData(0, 0, working.width, working.height);
        applyScanFilter(image, { ...opts, dpi: PREVIEW_DPI });
        if (token !== previewToken) return;
        const after = document.createElement("canvas");
        after.width = working.width;
        after.height = working.height;
        after.getContext("2d")!.putImageData(image, 0, 0);
        drawToCanvas(afterCanvas, after);
      } finally {
        if (token === previewToken) previewSpinner.hidden = true;
      }
    }

    function updatePager() {
      if (!pdf) return;
      pageIndicator.textContent = `${currentPage} / ${pdf.numPages}`;
      prevPageBtn.disabled = currentPage <= 1;
      nextPageBtn.disabled = currentPage >= pdf.numPages;
    }

    async function openFile(file: File) {
      if (file.type !== "application/pdf" && !file.name.endsWith(".pdf")) {
        alert(t.invalid);
        return;
      }
      fileName = file.name;
      fileBuffer = await file.arrayBuffer();
      const { loadPdf } = await getScanner();
      pdf = await loadPdf(fileBuffer.slice(0));
      currentPage = 1;

      fileNameEl.textContent = fileName;
      pageCountEl.textContent = `${pdf.numPages} ${pdf.numPages === 1 ? t.pageSingular : t.pagePlural}`;
      hero.hidden = true;
      workspace.hidden = false;
      updatePager();
      await refreshPreview();
    }

    dropzone.addEventListener("click", () => fileInput.click());
    fileInput.addEventListener("change", () => {
      if (fileInput.files?.[0]) openFile(fileInput.files[0]);
    });

    ["dragover", "dragenter"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.add("dragging");
      })
    );
    ["dragleave", "drop"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.remove("dragging");
      })
    );
    dropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) openFile(file);
    });

    modeEl.querySelectorAll("button").forEach((btn) =>
      btn.addEventListener("click", () => {
        modeEl.querySelectorAll("button").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        refreshPreview();
      })
    );

    let debounce: number | undefined;
    const liveInputs = [thresholdEl, blockRadiusEl, contrastEl];
    liveInputs.forEach((el) =>
      el.addEventListener("input", () => {
        thresholdVal.textContent = thresholdEl.value;
        blockRadiusVal.textContent = blockRadiusEl.value;
        contrastVal.textContent = parseFloat(contrastEl.value).toFixed(2);
        window.clearTimeout(debounce);
        debounce = window.setTimeout(refreshPreview, 180);
      })
    );
    dpiEl.addEventListener("change", refreshPreview);
    despeckleEl.addEventListener("change", refreshPreview);
    cropEnabledEl.addEventListener("change", refreshPreview);
    cropResetBtn.addEventListener("click", () => {
      cropQuad = defaultQuad();
      refreshPreview();
    });

    let activeCorner = -1;
    const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    function pointerToQuad(e: PointerEvent) {
      const rect = beforeWrap.getBoundingClientRect();
      cropQuad[activeCorner] = {
        x: clamp((e.clientX - rect.left) / rect.width),
        y: clamp((e.clientY - rect.top) / rect.height),
      };
      renderCropOverlay();
      window.clearTimeout(debounce);
      debounce = window.setTimeout(refreshPreview, 120);
    }
    cropHandles.forEach((handle) =>
      handle.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        activeCorner = parseInt(handle.dataset.corner!, 10);
        handle.setPointerCapture(e.pointerId);
      })
    );
    window.addEventListener("pointermove", (e) => {
      if (activeCorner >= 0) pointerToQuad(e);
    });
    window.addEventListener("pointerup", () => {
      activeCorner = -1;
    });

    // Keyboard operability for the crop corners (arrow keys nudge; Shift = larger step).
    cropHandles.forEach((handle) =>
      handle.addEventListener("keydown", (e) => {
        const i = parseInt(handle.dataset.corner!, 10);
        const step = e.shiftKey ? 0.05 : 0.01;
        let handled = true;
        if (e.key === "ArrowLeft") cropQuad[i].x = clamp(cropQuad[i].x - step);
        else if (e.key === "ArrowRight") cropQuad[i].x = clamp(cropQuad[i].x + step);
        else if (e.key === "ArrowUp") cropQuad[i].y = clamp(cropQuad[i].y - step);
        else if (e.key === "ArrowDown") cropQuad[i].y = clamp(cropQuad[i].y + step);
        else handled = false;
        if (handled) {
          e.preventDefault();
          renderCropOverlay();
          window.clearTimeout(debounce);
          debounce = window.setTimeout(refreshPreview, 120);
        }
      })
    );

    prevPageBtn.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        updatePager();
        refreshPreview();
      }
    });
    nextPageBtn.addEventListener("click", () => {
      if (pdf && currentPage < pdf.numPages) {
        currentPage++;
        updatePager();
        refreshPreview();
      }
    });

    resetBtn.addEventListener("click", () => {
      fileBuffer = null;
      pdf = null;
      fileInput.value = "";
      workspace.hidden = true;
      hero.hidden = false;
    });

    processBtn.addEventListener("click", async () => {
      if (!fileBuffer) return;
      const opts = readOptions();
      processBtn.disabled = true;
      resetBtn.disabled = true;
      progress.hidden = false;
      progressFill.style.transform = "scaleX(0)";
      progressText.textContent = t.starting;

      try {
        const { buildScannedPdf } = await getScanner();
        const blob = await buildScannedPdf(fileBuffer.slice(0), opts, ({ page, total }) => {
          const pct = Math.round((page / total) * 100);
          progressFill.style.transform = `scaleX(${pct / 100})`;
          progressText.textContent = t.processingPage
            .replace("{page}", String(page))
            .replace("{total}", String(total));
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = fileName.replace(/\.pdf$/i, "") + "-scanned.pdf";
        a.click();
        URL.revokeObjectURL(url);
        progressText.textContent = t.done;
      } catch (err) {
        console.error(err);
        progressText.textContent = t.error;
      } finally {
        processBtn.disabled = false;
        resetBtn.disabled = false;
      }
    });
  </script>

  <style>
    .seg-btn {
      border-radius: 6px;
      padding: 8px 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-body);
      cursor: pointer;
      transition: background-color 0.15s, color 0.15s;
    }
    .seg-btn:hover { color: var(--color-ink); }
    .seg-btn:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }
    .seg-btn.active { background: var(--color-ink); color: var(--color-canvas); }

    .canvas-wrap canvas { width: 100%; height: auto; display: block; }

    .crop-overlay { position: absolute; inset: 0; touch-action: none; }
    .crop-overlay svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    #cropPoly {
      fill: rgba(23, 23, 23, 0.08);
      stroke: #171717;
      stroke-width: 1.5;
      vector-effect: non-scaling-stroke;
    }
    .crop-handle {
      position: absolute;
      width: 22px;
      height: 22px;
      padding: 0;
      border-radius: 9999px;
      background: #171717;
      border: 3px solid #fff;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
      transform: translate(-50%, -50%);
      cursor: grab;
      touch-action: none;
    }
    .crop-handle:active { cursor: grabbing; }
    .crop-handle:focus-visible {
      outline: 2px solid #171717;
      outline-offset: 2px;
    }

    .spinner {
      position: absolute;
      inset: 0;
      margin: auto;
      width: 28px;
      height: 28px;
      border: 3px solid rgba(23, 23, 23, 0.15);
      border-top-color: #171717;
      border-radius: 9999px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .mesh {
      position: absolute;
      inset: -30% -10% auto -10%;
      height: 460px;
      pointer-events: none;
      filter: blur(24px);
      opacity: 0.45;
      background:
        radial-gradient(38% 60% at 12% 25%, #007cf0 0%, transparent 60%),
        radial-gradient(36% 58% at 40% 8%, #7928ca 0%, transparent 60%),
        radial-gradient(38% 60% at 68% 22%, #ff0080 0%, transparent 55%),
        radial-gradient(40% 60% at 92% 12%, #f9cb28 0%, transparent 55%);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
      mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
    }

    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; }
      #progressFill { transition: none; }
    }
  </style>
</BaseLayout>
