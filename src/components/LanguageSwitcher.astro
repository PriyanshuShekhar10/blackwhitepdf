---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES, getContent } from "../i18n";

interface Props {
  lang: string;
  /** Locale-agnostic route ("" home, "about"); null (legal) links to home. */
  route?: string | null;
}

const { lang, route = null } = Astro.props;
const linkRoute = route ?? "";
const c = getContent(lang);
const active = LOCALES.find((l) => l.code === lang) ?? LOCALES[0];
---

<details class="lang-switch relative">
  <summary
    aria-label={c.languageLabel}
    class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full border border-hairline px-2.5 text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 [&::-webkit-details-marker]:hidden"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
      <path
        d="M3 12h18M12 3c2.5 2.5 3.5 6 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-6-3.5-9s1-6.5 3.5-9Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="round"
      />
    </svg>
    <span class="max-w-[7rem] truncate" translate="no">{active.label}</span>
    <svg
      class="chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>

  <ul
    class="absolute end-0 z-50 mt-2 max-h-[70vh] w-52 overflow-auto overscroll-contain rounded-lg border border-hairline bg-canvas p-1 shadow-float"
  >
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={getRelativeLocaleUrl(l.code, linkRoute)}
            hreflang={l.hreflang}
            lang={l.hreflang}
            data-astro-reload
            aria-current={l.code === lang ? "true" : undefined}
            translate="no"
            class:list={[
              "flex items-center justify-between rounded-md px-3 py-2 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40",
              l.code === lang
                ? "bg-canvas-soft font-medium text-ink"
                : "text-body hover:bg-canvas-soft hover:text-ink",
            ]}
          >
            <span class="truncate">{l.label}</span>
            {l.code === lang && (
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12l5 5 9-9"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch summary::-webkit-details-marker {
    display: none;
  }
  .lang-switch[open] .chevron {
    transform: rotate(180deg);
  }
  .chevron {
    transition: transform 0.15s ease;
  }
</style>

<script>
  // Close any open language dropdown when clicking outside of it.
  document.addEventListener("click", (e) => {
    document
      .querySelectorAll<HTMLDetailsElement>("details.lang-switch[open]")
      .forEach((d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      });
  });
</script>
